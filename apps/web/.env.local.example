# Copy to .env.local and adjust.
#
# One variable, used by both the browser and the server. Next.js only inlines
# NEXT_PUBLIC_* into the client bundle; for the server components that render
# public merchant pages, the same value is read directly from process.env.
#
# 127.0.0.1 rather than localhost: on Windows, localhost can resolve to ::1
# first, and a Node server bound to IPv4 only refuses the connection.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3000/v1
