# ---------------------------------------------------------------------------
# Copy to `.env` and fill in the secrets. Every value below has a code default
# in `apps/api/src/config/configuration.ts` except the ones marked REQUIRED.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
API_PREFIX=v1
CORS_ORIGINS=http://localhost:3001

# REQUIRED
DATABASE_URL=postgresql://takeout:takeout@localhost:5432/takeout?schema=public
REDIS_URL=redis://localhost:6379

# REQUIRED — must be at least 32 characters. Boot fails otherwise.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------------------------------------------------------------------------
# Pricing
# ---------------------------------------------------------------------------
# The per-main-item platform fee in MINOR UNITS. 350 = HK$3.50.
# This is only the fallback: a `platform_config` row with the key
# `pricing.platform_fee_per_main_item_minor` overrides it at boot, so the rate
# can be changed without a redeploy.
PLATFORM_FEE_PER_MAIN_ITEM_MINOR=350
PLATFORM_FEE_COUNT_ADDONS=false
CUSTOMER_SERVICE_FEE_MINOR=0
MINIMUM_PAYOUT_MINOR=0
CURRENCY=HKD

# ---------------------------------------------------------------------------
# Payment rails
# ---------------------------------------------------------------------------
# The rail used when the customer does not pick one. Must be one of
# STRIPE | PAYME | OCTOPUS | FPS_QR — anything else fails at boot, because a
# typo here used to be silently ignored and every order went to Stripe.
#
# A rail with no credentials is still listed by `GET /v1/payments/rails`, but
# reports `configured: false` and refuses a checkout with
# `422 PAYMENT_RAIL_UNAVAILABLE` naming the variables it needs.
PAYMENT_PROVIDER=STRIPE
PAYMENT_FEE_RATE_BPS=340
PAYMENT_FEE_FIXED_MINOR=235
# Where the customer completes a non-card payment. None of the HK rails has a
# hosted checkout to redirect to, so the platform hosts the page itself.
PAYMENT_CHECKOUT_BASE_URL=http://localhost:3001/pay
# When false the PSP is never contacted: payment intents are simulated and
# refunds are recorded as PENDING for manual settlement. Defaults to true only
# in production. Keep it false in development and CI.
PAYMENT_LIVE_MODE=false

# --- Stripe (cards) --------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- PayMe for Business ----------------------------------------------------
# The customer pays inside the PayMe app; settlement arrives as a signed
# callback on `POST /v1/webhooks/payments/payme` (header `x-payme-signature`).
PAYME_MERCHANT_ID=
PAYME_WEBHOOK_SECRET=

# --- Octopus / O! ePay -----------------------------------------------------
# Same shape as PayMe. Callback header: `x-octopus-signature`.
OCTOPUS_MERCHANT_ID=
OCTOPUS_WEBHOOK_SECRET=

# --- 轉數快 FPS QR -----------------------------------------------------------
# `FPS_ID` and `FPS_MERCHANT_NAME` are encoded into the EMVCo QR payload, so a
# wrong value produces a QR that scans and pays the wrong person. A plain FPS
# transfer has no callback from the banking system; settlement is confirmed
# either by an acquirer's aggregation service (header `x-fps-signature`) or by
# an operator reading the bank statement.
FPS_ID=
FPS_MERCHANT_NAME=
FPS_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Cancellation / refund policy
# ---------------------------------------------------------------------------
# Ratios are BASIS POINTS (10000 = 100%), the same unit the payment fee uses.
# A `platform_config` row with the key `cancellation.refund_bps_*` overrides
# these at boot, so finance can retune a refund percentage without a redeploy.
# A value outside 0..10000 fails at boot — it would return money never captured.
# Minutes after acceptance during which a customer may still cancel free.
CANCELLATION_GRACE_MINUTES=2
CANCELLATION_REFUND_BPS_FREE=10000
CANCELLATION_REFUND_BPS_LATE=0
CANCELLATION_REFUND_BPS_NON_REFUNDABLE=0
CANCELLATION_REFUND_BPS_MERCHANT_FAULT=10000
CANCELLATION_REFUND_BPS_PLATFORM_FAULT=10000
CANCELLATION_REFUND_BPS_GOODWILL=10000

# ---------------------------------------------------------------------------
# Customer reviews
# ---------------------------------------------------------------------------
# How long after collection an order can still be rated. An unbounded window
# means a three-month-old order can be rated exactly when a merchant's ranking
# matters most.
REVIEW_WINDOW_DAYS=14
REVIEW_MAX_COMMENT_LENGTH=1000
REVIEW_MAX_REPLY_LENGTH=600

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# Bearer token for `GET /metrics`. Empty means "serve the exposition outside
# production only" — in production an unset token refuses every scrape, because
# a hardcoded default would be a published secret.
METRICS_TOKEN=

# ---------------------------------------------------------------------------
# Cloudflare R2 (S3-compatible). REQUIRED in production.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=takeout-media
# CDN domain used to build read URLs, e.g. https://cdn.example.com
R2_PUBLIC_BASE_URL=
R2_PRESIGN_TTL_SECONDS=900
R2_MAX_UPLOAD_BYTES=5242880

# ---------------------------------------------------------------------------
# Ordering rules
# ---------------------------------------------------------------------------
ACCEPT_TIMEOUT_MINUTES=5
PICKUP_WINDOW_MINUTES=60
PAYMENT_TIMEOUT_MINUTES=15
# How often the timeout sweeper and the refund reactor run, in milliseconds.
ORDER_SWEEP_INTERVAL_MS=30000
# Master switch for both background loops. Off in `test` automatically; the e2e
# suite also turns it off so a backdated deadline cannot be swept mid-assertion.
ORDER_BACKGROUND_JOBS=true
# Days of `menu_item_daily_stock` to keep. Only the current service day is read.
QUOTA_RETENTION_DAYS=30
