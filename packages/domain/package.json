{
  "name": "@takeout/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Pure domain layer: PricingEngine, OrderStateMachine, IDispatchService. Zero runtime dependencies.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
